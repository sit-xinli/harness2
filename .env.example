# Copy to .env and fill in. Shell variables override these.
# See docs/SETUP.md for details.

# --- Required ---

# Executor model in OpenCode's provider/model format.
HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-pro

# Bare judge model ID (adapter adds the Vertex prefix). Required for benchmark judging.
# Gemini or Claude on Vertex both work (Claude judge is LAB-only); uses gcloud ADC.
HARNESS2_JUDGE_MODEL=gemini-2.5-pro
# HARNESS2_JUDGE_MODEL=claude-sonnet-4

# --- Vertex AI ---
# Needed for google-vertex/* models. LOCATION defaults to "global".
GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# --- Optional models (default to the executor) ---
# HARNESS2_IMPROVER_MODEL=google-vertex/claude-sonnet-4

# --- Optional: output location (defaults to runs/) ---
# HARNESS2_RUNS_DIR=runs

# --- Optional: judge via a non-Vertex OpenAI-compatible endpoint ---
# For OpenAI: set JUDGE_MODEL above to a bare ID (e.g. gpt-4o), then:
# HARNESS2_JUDGE_BASE_URL=https://api.openai.com/v1
# HARNESS2_JUDGE_API_KEY=sk-...

# --- Optional: Codex executor (run setup with --substrate cx) ---
# Points at any OpenAI-compatible Responses endpoint; example uses OpenAI directly.
# HARNESS2_CODEX_MODEL=gpt-5-codex
# HARNESS2_CODEX_BASE_URL=https://api.openai.com/v1
# HARNESS2_CODEX_API_KEY=sk-...
# HARNESS2_CODEX_CONTAINER_URL=   # container-reachable URL for WorkBuddy; defaults to CODEX_BASE_URL
#
# Or front a non-OpenAI backend (e.g. Vertex) with a local proxy that speaks the
# Responses API. WorkBuddy's container reaches the host via host.docker.internal:
# HARNESS2_CODEX_BASE_URL=http://127.0.0.1:8080/v1
# HARNESS2_CODEX_CONTAINER_URL=http://host.docker.internal:8080/v1
# HARNESS2_CODEX_API_KEY=your-proxy-key
